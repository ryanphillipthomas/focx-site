{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focx-waitlist",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    // Production allowlist is hardcoded in the Worker (https://focx.ai, https://www.focx.ai).
    // Leave this empty in production. Never put localhost here.
    "EXTRA_ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focx-waitlist",
      // PLACEHOLDER — replace after `wrangler d1 create focx-waitlist`. Do not create in this PR.
      "database_id": "00000000-0000-4000-8000-000000000001",
      // wrangler dev --remote uses this instead of database_id, so local remote-dev
      // never writes to the production table. Replace with the preview D1 id.
      "preview_database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "7101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Production same-origin route. Do NOT uncomment in this PR.
  // focx.ai is proxied through Cloudflare, so this route answers even while the
  // page origin is suspended. Enable only in the launch PR Ryan approves.
  // "routes": [{ "pattern": "focx.ai/api/waitlist*", "zone_name": "focx.ai" }],
  "env": {
    "preview": {
      "name": "focx-waitlist-preview",
      "workers_dev": true,
      "vars": {
        // Configurable allowlist: comma-separated exact origins and/or fully
        // anchored regexes. Localhost is preview/dev only — never copy these
        // into the production EXTRA_ALLOWED_ORIGINS value.
        "EXTRA_ALLOWED_ORIGINS": "https://focx-waitlist-preview.onrender.com,http://localhost:8123,http://127.0.0.1:8123"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "focx-waitlist-preview",
          // PLACEHOLDER — replace after `wrangler d1 create focx-waitlist-preview`.
          "database_id": "00000000-0000-4000-8000-000000000002",
          // Named local id so wrangler dev --remote --env preview cannot fall
          // back to a production database_id.
          "preview_database_id": "local-focx-waitlist-preview",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "WAITLIST_RATE_LIMITER",
          "namespace_id": "7102",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
